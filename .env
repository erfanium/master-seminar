# Configuration file for the pipeline

# Merge and Filtering
MISSING_TO_REF=true
# VARIANT_FILTER_EXPRESSION='none'
# SAMPLES_TO_IGNORE=40107401408,20607401428,21207402235,30507401108,30507401754,30507401755,30507401838,30807401023,40807405576,40807405584
# PCA
PCA_COUNT=10

# Cluster 
CLUSTER_ALGO=agglomerative
DBSCAN_EPS=1
DBSCAN_MIN_SAMPLES=2
HDBSCAN_MIN_CLUSTER_SIZE=2
HDBSCAN_MIN_SAMPLES=2
CLUSTER_N_CLUSTERS=10
CLUSTER_LINKAGE=ward
CLUSTER_RANDOM_STATE=42
CLUSTER_LIMIT_PCA=4
CLUSTER_WEIGHT_EIGENVALUES=false

SKIP_CLUSTER_TOPK_VARIANT_CALCULATION=false
SKIP_CLUSTER_PROFILE=true
SKIP_MDS=true


# INFO field DP (DP=64): This is the total read depth across all samples at this variant position. It's a site-level metric.
# FORMAT/Sample DP (DP=63): This is the read depth for the specific sample in the genotype column. It's a sample-level metric.

# INFO/DP is always greater than FORMAT/DP
# export VARIANT_FILTER_EXPRESSION='MAF<0.10 && MAF>0'
PRE_MERGE_FILTER_EXPRESSION='FILTER=="PASS" && FORMAT/DP>=10 && GQ>=30'
POST_FILTER_SYMLINK_ONLY=true
DISABLE_MERGE_CSV=true